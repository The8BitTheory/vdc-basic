1 REM **NE
2 REM VERTEX ROTATION TEST: PORT OF VERTROT.BAS (QUICKBASIC, JOEL YLILUOMA 2015,
3 REM HTTP://IKI.FI/BISQWIT/) TO BASIC 7.0 + VDC-BASIC V3, 160 X 100, 16 COLOURS.
4 REM OPTIMISED VERSION: THE SAME PICTURE AS VERTROT.BAS, PIXEL FOR PIXEL, WITH FEWER
5 REM STATEMENTS: SIN/COS ONCE PER FRAME; ONE VMC COPIES A TEMPLATE OF ROWS 20-74
6 REM (CLEAR VIEWS, SIDE BORDERS, THE WALL IN THE MAP, THE PLAYER IN THE SECOND VIEW);
7 REM ONE VDM FOR BOTH PAGES (PAGE B = ROWS 100-199); CLIPPING ONLY WHEN NEEDED.
8 REM VRAM: 16000 PAGE A, 24000 PAGE B, 32000 TEMPLATE (4400 BYTES).
9 REM A1 B1 A2 B2 = VX1 VY1 VX2 VY2, T U Z = TX TY TZ, I J = IX IZ, X1 YA YB X2 YC YD.
20 IF PEEK(46)<>64 THEN PRINT"RUN"CHR$(34)"BOOT"CHR$(34)" FIRST":END
30 FAST:BANK 15:POKE 7166,96:POKE 7167,96
40 GOSUB 9000:READ W$
100 A1=70:B1=20:A2=70:B2=70
110 PX=50:PY=50:AG=0:SN=SIN(AG):CS=COS(AG)
120 GOSUB 8000:YO=100:PH=93:PL=192:FR=0
130 TT=TI
200 REM --- ONE FRAME, DRAWN INTO THE HIDDEN PAGE (YO = 0: PAGE A, 100: PAGE B) ---
210 SYS 7166
220 ::VMC 32000,17600+YO*80,4400
300 REM THE ABSOLUTE MAP (THE WALL IS IN THE TEMPLATE)
310 OX=2:OY=20+YO:VW=49:VH=54
340 LA=PX/2:LB=PY/2:LC=(CS*5+PX)/2:LD=(SN*5+PY)/2:LK=1:GOSUB 3000
350 LA=PX/2:LB=PY/2:LC=LA:LD=LB:LK=15:GOSUB 3000
400 REM THE TRANSFORMED MAP
410 OX=54
430 T1=A1-PX:U1=B1-PY
440 T2=A2-PX:U2=B2-PY
450 Z1=T1*CS+U1*SN
460 Z2=T2*CS+U2*SN
470 T1=T1*SN-U1*CS
480 T2=T2*SN-U2*CS
490 LA=(50-T1)/2:LB=(50-Z1)/2:LC=(50-T2)/2:LD=(50-Z2)/2:LK=13:GOSUB 3000
491 REM THE PLAYER (IN THE TEMPLATE) AGAIN ONLY IF THE WALL MAY HAVE COVERED IT
492 IF LA>=26 AND LC>=26 OR LA<=24 AND LC<=24 OR LB>=26 AND LD>=26 OR LB<=22 AND LD<=22 THEN 500
493 ::VDL 79,43+YO,79,45+YO,1:::VDL 79,45+YO,79,45+YO,15
500 REM THE PERSPECTIVE-TRANSFORMED MAP
510 OX=107:VW=50
530 IF Z1<=0 AND Z2<=0 THEN 700
540 E1=T1:F1=Z1:E2=T2:F2=Z2:E3=-.0001:F3=.0001:E4=-20:F4=5:GOSUB 4000:I1=IX:J1=IY
550 E1=T1:F1=Z1:E2=T2:F2=Z2:E3=.0001:F3=.0001:E4=20:F4=5:GOSUB 4000:I2=IX:J2=IY
560 IF Z1>0 THEN 570
565 IF J1>0 THEN T1=I1:Z1=J1:ELSE T1=I2:Z1=J2
570 IF Z2>0 THEN 580
575 IF J1>0 THEN T2=I1:Z2=J1:ELSE T2=I2:Z2=J2
580 X1=-T1*16/Z1:YA=-50/Z1:YB=50/Z1
590 X2=-T2*16/Z2:YC=-50/Z2:YD=50/Z2
600 LA=(50+X1)/2:LB=(50+YA)/2:LC=(50+X2)/2:LD=(50+YC)/2:LK=13:GOSUB 3000
610 LA=(50+X1)/2:LB=(50+YB)/2:LC=(50+X2)/2:LD=(50+YD)/2:LK=13:GOSUB 3000
620 LA=(50+X1)/2:LB=(50+YA)/2:LC=(50+X1)/2:LD=(50+YB)/2:LK=12:GOSUB 3000
630 LA=(50+X2)/2:LB=(50+YC)/2:LC=(50+X2)/2:LD=(50+YD)/2:LK=12:GOSUB 3000
700 REM SHOW THE PAGE AT THE NEXT VERTICAL BLANK, DRAW INTO THE OTHER ONE
710 SYS 7167
720 ::SYN 20,PH,21,PL
730 YO=100-YO:PH=155-PH:PL=320-PL
800 REM --- KEYS: THE NEXT STEP OF THE PATH ---
810 FR=FR+1:IF FR>LEN(W$) THEN 890
820 A$=MID$(W$,FR,1)
830 IF A$="U" THEN PX=PX+CS:PY=PY+SN:GOTO 200
840 IF A$="D" THEN PX=PX-CS:PY=PY-SN:GOTO 200
850 IF A$="L" THEN AG=AG-.1:SN=SIN(AG):CS=COS(AG):GOTO 200
860 IF A$="R" THEN AG=AG+.1:SN=SIN(AG):CS=COS(AG):GOTO 200
870 IF A$="A" THEN PX=PX+SN:PY=PY-CS:GOTO 200
880 IF A$="E" THEN PX=PX-SN:PY=PY+CS
885 GOTO 200
890 TT=TI-TT:BANK 15:POKE DEC("D7FF"),0
891 GETKEY K$:::RST 3
892 PRINT CHR$(147)FR"FRAMES,"INT(TT/FR*1000/60+.5)"MS PER FRAME"
893 END
3000 REM --- LINE (LA,LB)-(LC,LD),LK IN THE VIEW AT OX,OY (0..VW, 0..VH) ---
3010 IF LA<0 OR LA>VW OR LB<0 OR LB>VH OR LC<0 OR LC>VW OR LD<0 OR LD>VH THEN 3020
3015 Q1=OX+INT(LA+.5):Q2=OY+INT(LB+.5):Q3=OX+INT(LC+.5):Q4=OY+INT(LD+.5)
3016 ::VDL Q1,Q2,Q3,Q4,LK:RETURN
3020 CA=0:IF LA<0 THEN CA=1:ELSE IF LA>VW THEN CA=2
3021 IF LB<0 THEN CA=CA+4:ELSE IF LB>VH THEN CA=CA+8
3022 CB=0:IF LC<0 THEN CB=1:ELSE IF LC>VW THEN CB=2
3023 IF LD<0 THEN CB=CB+4:ELSE IF LD>VH THEN CB=CB+8
3030 IF (CAORCB)=0 THEN 3015
3040 IF CAANDCB THEN RETURN
3050 C=CA:IF C=0 THEN C=CB
3060 IF CAND8 THEN U=LA+(LC-LA)*(VH-LB)/(LD-LB):V=VH:GOTO 3100
3070 IF CAND4 THEN U=LA+(LC-LA)*(0-LB)/(LD-LB):V=0:GOTO 3100
3080 IF CAND2 THEN V=LB+(LD-LB)*(VW-LA)/(LC-LA):U=VW:GOTO 3100
3090 V=LB+(LD-LB)*(0-LA)/(LC-LA):U=0
3100 IF C=CA THEN LA=U:LB=V:GOTO 3020
3110 LC=U:LD=V:GOTO 3020
4000 REM --- INTERSECT (E1,F1)-(E2,F2) WITH (E3,F3)-(E4,F4) -> IX,IY ---
4010 REM AS IN THE ORIGINAL, THE SECOND LINE ALREADY USES THE NEW X
4020 IX=E1*F2-F1*E2
4030 IY=E3*F4-F3*E4
4040 DT=(E1-E2)*(F3-F4)-(F1-F2)*(E3-E4)
4050 IX=(IX*(E3-E4)-(E1-E2)*IY)/DT
4060 IY=(IX*(F3-F4)-(F1-F2)*IY)/DT
4070 RETURN
6000 REM THE PATH OF THE PLAYER
6010 DATA "UUUUUUUUUURRRRRRRRRRAAAAAAAAAALLLLLLLLLLLLLLLLLLLLUUUUUUUUUUUUUURRRRRRRRRRRRRRRRDDDDDDDDDD"
8000 REM --- BOTH PAGES AND THE TEMPLATE: VIEWS, BORDERS, WALL, PLAYER ---
8010 ::VDM 1,16000,80
8020 ::VDR 1,19,52,57,2:::VDR 53,19,52,57,4:::VDR 106,19,53,57,6
8030 OX=2:OY=20:VW=49:VH=54:LA=A1/2:LB=B1/2:LC=A2/2:LD=B2/2:LK=13:GOSUB 3000
8040 ::VDL 79,43,79,45,1:::VDL 79,45,79,45,15
8050 ::VMC 17600,32000,4400:::VMC 16000,24000,8000
8060 RETURN
9000 REM --- 160 X 100 PIXELS, 16 COLOURS. NEEDS 64 KIB VRAM (CHAPTER 5) ---
9010 ::T=RGD(255)
9015 IF T=0 THEN PRINT"THIS PROGRAM NEEDS 64 KIB VRAM":END
9020 ::RST 1:::RGO 28,16
9030 ::T=(RGD(4)+1)*8+(RGD(5)AND31):::V=RGD(7)
9040 ::RGW 9,1:::RGW 4,T/2-1:::RGW 6,100:::RGW 7,V*4
9050 ::VMF 0,15,16000:::VMF 16000,0,16000
9060 ::DISP 0:::ATTR 16000:::RGO 25,128:RETURN
63999 GRAPHIC 0
