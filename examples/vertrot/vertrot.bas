1 REM **NE
2 REM VERTEX ROTATION TEST: PORT OF VERTROT.BAS (QUICKBASIC, JOEL YLILUOMA 2015,
3 REM HTTP://IKI.FI/BISQWIT/) TO BASIC 7.0 + VDC-BASIC V3, 160 X 100, 16 COLOURS.
4 REM 1:1 VERSION: SAME STATEMENTS AND ARITHMETIC; WHAT QBASIC DOES INSIDE
5 REM VIEW/LINE/PSET (CLEARING, BORDER, CLIPPING, ROUNDING) IS DONE HERE IN BASIC.
6 REM SCALE 1/2: SCREEN 7 (320 X 200) -> 160 X 100. TWO PAGES (VRAM 16000, 24000).
7 REM THE PLAYER FOLLOWS THE PATH W$ INSTEAD OF THE KEYBOARD (U D = ARROW UP/DOWN,
8 REM L R = ARROW LEFT/RIGHT, A E = KEYS A/D). SYS 7166/7167 MARK THE DRAWING.
9 REM A1 B1 A2 B2 = VX1 VY1 VX2 VY2, T U Z = TX TY TZ, I J = IX IZ, X1 YA YB X2 YC YD.
20 IF PEEK(46)<>64 THEN PRINT"RUN"CHR$(34)"BOOT"CHR$(34)" FIRST":END
30 FAST:BANK 15:POKE 7166,96:POKE 7167,96
40 GOSUB 9000:READ W$
100 A1=70:B1=20:A2=70:B2=70
110 PX=50:PY=50:AG=0
120 DP=24000:FR=0
200 REM --- ONE FRAME, DRAWN INTO THE HIDDEN PAGE DP ---
210 SYS 7166
220 ::VDM 1,DP,80
300 REM VIEW(4,40)-(103,149),0,1: THE ABSOLUTE MAP
310 OX=2:OY=20:VW=49:VH=54
320 ::VDB 2,20,50,55,0:::VDR 1,19,52,57,2
330 LA=A1/2:LB=B1/2:LC=A2/2:LD=B2/2:LK=13:GOSUB 3000
340 LA=PX/2:LB=PY/2:LC=(COS(AG)*5+PX)/2:LD=(SIN(AG)*5+PY)/2:LK=1:GOSUB 3000
350 LA=PX/2:LB=PY/2:LC=LA:LD=LB:LK=15:GOSUB 3000
400 REM VIEW(109,40)-(208,149),0,2: THE TRANSFORMED MAP
410 OX=54:OY=20:VW=49:VH=54
420 ::VDB 54,20,50,55,0:::VDR 53,19,52,57,4
430 T1=A1-PX:U1=B1-PY
440 T2=A2-PX:U2=B2-PY
450 Z1=T1*COS(AG)+U1*SIN(AG)
460 Z2=T2*COS(AG)+U2*SIN(AG)
470 T1=T1*SIN(AG)-U1*COS(AG)
480 T2=T2*SIN(AG)-U2*COS(AG)
490 LA=(50-T1)/2:LB=(50-Z1)/2:LC=(50-T2)/2:LD=(50-Z2)/2:LK=13:GOSUB 3000
491 LA=25:LB=25:LC=25:LD=22.5:LK=1:GOSUB 3000
492 LA=25:LB=25:LC=25:LD=25:LK=15:GOSUB 3000
500 REM VIEW(214,40)-(315,149),0,3: THE PERSPECTIVE-TRANSFORMED MAP
510 OX=107:OY=20:VW=50:VH=54
520 ::VDB 107,20,51,55,0:::VDR 106,19,53,57,6
530 IF Z1<=0 AND Z2<=0 THEN 700
540 E1=T1:F1=Z1:E2=T2:F2=Z2:E3=-.0001:F3=.0001:E4=-20:F4=5:GOSUB 4000:I1=IX:J1=IY
550 E1=T1:F1=Z1:E2=T2:F2=Z2:E3=.0001:F3=.0001:E4=20:F4=5:GOSUB 4000:I2=IX:J2=IY
560 IF Z1>0 THEN 570
565 IF J1>0 THEN T1=I1:Z1=J1:ELSE T1=I2:Z1=J2
570 IF Z2>0 THEN 580
575 IF J1>0 THEN T2=I1:Z2=J1:ELSE T2=I2:Z2=J2
580 X1=-T1*16/Z1:YA=-50/Z1:YB=50/Z1
590 X2=-T2*16/Z2:YC=-50/Z2:YD=50/Z2
600 LA=(50+X1)/2:LB=(50+YA)/2:LC=(50+X2)/2:LD=(50+YC)/2:LK=13:GOSUB 3000
610 LA=(50+X1)/2:LB=(50+YB)/2:LC=(50+X2)/2:LD=(50+YD)/2:LK=13:GOSUB 3000
620 LA=(50+X1)/2:LB=(50+YA)/2:LC=(50+X1)/2:LD=(50+YB)/2:LK=12:GOSUB 3000
630 LA=(50+X2)/2:LB=(50+YC)/2:LC=(50+X2)/2:LD=(50+YD)/2:LK=12:GOSUB 3000
700 REM SHOW THE PAGE AT THE NEXT VERTICAL BLANK, DRAW INTO THE OTHER ONE
710 SYS 7167
720 ::SYN 20,DP/256,21,DPAND255
730 DP=40000-DP
800 REM --- KEYS: THE NEXT STEP OF THE PATH ---
810 FR=FR+1:IF FR>LEN(W$) THEN 890
820 A$=MID$(W$,FR,1)
830 IF A$="U" THEN PX=PX+COS(AG):PY=PY+SIN(AG)
840 IF A$="D" THEN PX=PX-COS(AG):PY=PY-SIN(AG)
850 IF A$="L" THEN AG=AG-.1
860 IF A$="R" THEN AG=AG+.1
870 IF A$="A" THEN PX=PX+SIN(AG):PY=PY-COS(AG)
880 IF A$="E" THEN PX=PX-SIN(AG):PY=PY+COS(AG)
885 GOTO 200
890 BANK 15:POKE DEC("D7FF"),0:END
3000 REM --- LINE (LA,LB)-(LC,LD),LK IN THE VIEW AT OX,OY (0..VW, 0..VH) ---
3010 REM COHEN-SUTHERLAND CLIPPING, THEN ROUNDING TO THE NEAREST PIXEL
3020 U=LA:V=LB:GOSUB 3200:CA=C:U=LC:V=LD:GOSUB 3200:CB=C
3030 IF (CAORCB)=0 THEN::VDL OX+INT(LA+.5),OY+INT(LB+.5),OX+INT(LC+.5),OY+INT(LD+.5),LK:RETURN
3040 IF CAANDCB THEN RETURN
3050 C=CA:IF C=0 THEN C=CB
3060 IF CAND8 THEN U=LA+(LC-LA)*(VH-LB)/(LD-LB):V=VH:GOTO 3100
3070 IF CAND4 THEN U=LA+(LC-LA)*(0-LB)/(LD-LB):V=0:GOTO 3100
3080 IF CAND2 THEN V=LB+(LD-LB)*(VW-LA)/(LC-LA):U=VW:GOTO 3100
3090 V=LB+(LD-LB)*(0-LA)/(LC-LA):U=0
3100 IF C=CA THEN LA=U:LB=V:GOSUB 3200:CA=C:GOTO 3030
3110 LC=U:LD=V:GOSUB 3200:CB=C:GOTO 3030
3200 C=0:IF U<0 THEN C=1:ELSE IF U>VW THEN C=2
3210 IF V<0 THEN C=C+4:ELSE IF V>VH THEN C=C+8
3220 RETURN
4000 REM --- INTERSECT (E1,F1)-(E2,F2) WITH (E3,F3)-(E4,F4) -> IX,IY ---
4010 REM AS IN THE ORIGINAL, THE SECOND LINE ALREADY USES THE NEW X
4020 IX=E1*F2-F1*E2
4030 IY=E3*F4-F3*E4
4040 DT=(E1-E2)*(F3-F4)-(F1-F2)*(E3-E4)
4050 IX=(IX*(E3-E4)-(E1-E2)*IY)/DT
4060 IY=(IX*(F3-F4)-(F1-F2)*IY)/DT
4070 RETURN
6000 REM THE PATH OF THE PLAYER
6010 DATA "UUUUUUUUUURRRRRRRRRRAAAAAAAAAALLLLLLLLLLLLLLLLLLLLUUUUUUUUUUUUUURRRRRRRRRRRRRRRRDDDDDDDDDD"
9000 REM --- 160 X 100 PIXELS, 16 COLOURS. NEEDS 64 KIB VRAM (CHAPTER 5) ---
9010 ::T=RGD(255)
9015 IF T=0 THEN PRINT"THIS PROGRAM NEEDS 64 KIB VRAM":END
9020 ::RST 1:::RGO 28,16
9030 ::T=(RGD(4)+1)*8+(RGD(5)AND31):::V=RGD(7)
9040 ::RGW 9,1:::RGW 4,T/2-1:::RGW 6,100:::RGW 7,V*4
9050 ::VMF 0,15,16000:::VMF 16000,0,16000
9060 ::DISP 0:::ATTR 16000:::RGO 25,128:RETURN
63999 GRAPHIC 0
